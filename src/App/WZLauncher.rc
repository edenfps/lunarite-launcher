// WZLauncher.rc - launcher dialog, icon, version info and manifest.

#include <winresrc.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

IDI_WZLAUNCHER          ICON            "res\WZLauncher.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "res\WZLauncher.manifest"

IDD_WZLAUNCHER_DIALOG DIALOGEX 0, 0, 320, 200
STYLE DS_SETFONT | DS_FIXEDSYS | WS_VISIBLE | WS_POPUP | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
FONT 9, "MS Shell Dlg", 400, 0, 0x0
BEGIN
    CONTROL         "Update Game",IDC_BTN_UPDATE,"Button",BS_OWNERDRAW | WS_TABSTOP,93,7,50,14
    CONTROL         "Min",IDC_BTN_MINIMIZE,"Button",BS_OWNERDRAW | WS_TABSTOP,7,42,50,14
    CONTROL         "Exit",IDC_BTN_EXIT,"Button",BS_OWNERDRAW | WS_TABSTOP,7,63,50,14
    CONTROL         "",IDC_EXPLORER,"Static",SS_LEFT | WS_TABSTOP,7,7,60,25
    CONTROL         "Caption",IDC_STATIC_TITLE,"Static",SS_LEFT,7,106,24,8
    CONTROL         "Update State",IDC_STATIC_TOTAL,"Static",SS_LEFT,7,125,43,8
    CONTROL         "File State",IDC_STATIC_FILE,"Static",SS_LEFT,7,142,30,8
    CONTROL         "",IDC_PROGRESS_TOTAL,"msctls_progress32",WS_BORDER,7,156,80,14
    CONTROL         "",IDC_PROGRESS_FILE,"msctls_progress32",WS_BORDER,7,179,80,14
    CONTROL         "Stop Update",IDC_BTN_STOP,"Button",BS_OWNERDRAW | WS_TABSTOP,93,27,50,14
    CONTROL         "Execute Game",IDC_BTN_EXECUTE,"Button",BS_OWNERDRAW | WS_TABSTOP,93,47,50,14
    CONTROL         "Game Config",IDC_BTN_CONFIG,"Button",BS_OWNERDRAW | WS_TABSTOP,93,67,50,14
    CONTROL         "Install Game",IDC_BTN_INSTALL,"Button",BS_OWNERDRAW | WS_TABSTOP,93,87,50,14
    CONTROL         "Auto Start Game",IDC_CHK_AUTOEXEC,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,95,108,70,10
    CONTROL         "Vulkan (DXVK)",IDC_CHK_DXVK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,95,120,70,10
    CONTROL         "Korean",IDC_CHK_LANG,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,95,132,70,10
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,2
 PRODUCTVERSION 1,0,0,2
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Lunarite"
            VALUE "FileDescription", "Lunarite Launcher"
            VALUE "FileVersion", "1.0.0.2"
            VALUE "InternalName", "WZLauncher.exe"
            VALUE "LegalCopyright", "Non-commercial fan project"
            VALUE "OriginalFilename", "WZLauncher.exe"
            VALUE "ProductName", "Lunarite Launcher"
            VALUE "ProductVersion", "1.0.0.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
